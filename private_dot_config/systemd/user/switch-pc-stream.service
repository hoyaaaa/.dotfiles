[Unit]
Description=Stock Nintendo Switch JPEG desktop streaming server
After=graphical-session.target network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/hoya/workspace/Switch-PC-Stream
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_SESSION_TYPE=wayland
Environment=SWITCH_STREAM_HOST=127.0.0.1
Environment=SWITCH_STREAM_PORT=8082
ExecStart=/home/hoya/workspace/Switch-PC-Stream/.venv/bin/python /home/hoya/workspace/Switch-PC-Stream/server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
