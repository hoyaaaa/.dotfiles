{{ if eq .chezmoi.os "darwin" }}
macos-option-as-alt = true
shell-integration = zsh
font-family = D2Coding
theme = Catppuccin Latte
{{ else }}
shell-integration = detect
font-family = Jetendard
font-size = 12
theme = Catppuccin Mocha
window-padding-x = 10
window-padding-y = 8
window-padding-balance = true
gtk-titlebar = true
cursor-style = block
cursor-style-blink = false
{{ end }}
mouse-hide-while-typing = true
scrollback-limit = 1000000

keybind = ctrl+shift+a>h=goto_split:left
keybind = ctrl+shift+a>j=goto_split:bottom
keybind = ctrl+shift+a>k=goto_split:top
keybind = ctrl+shift+a>l=goto_split:right

keybind = ctrl+a>h=new_split:left
keybind = ctrl+a>j=new_split:down
keybind = ctrl+a>k=new_split:up
keybind = ctrl+a>l=new_split:right
keybind = ctrl+a>f=toggle_split_zoom

keybind = ctrl+a>n=next_tab
keybind = ctrl+a>p=previous_tab

keybind = alt+r=reload_config

{{ if eq .chezmoi.os "darwin" }}
window-save-state = always
{{ end }}
