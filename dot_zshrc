# nohup
run_bg() {
  if [ $# -eq 0 ]; then
    echo "usage: run_bg <command>"
    return 1
  fi

  local name=$(echo "$1" | awk '{print $1}')
  local ts=$(date +%Y%m%d_%H%M%S)
  local log="/tmp/${name}_${ts}.log"

  nohup "$@" > "$log" 2>&1 &

  local pid=$!
  echo "started: pid=$pid"
  echo "log: $log"
}
