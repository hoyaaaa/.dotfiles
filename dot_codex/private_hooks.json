{
  "description": "Global lifecycle hooks for Secretive signing, dotfiles sync, and ego-lite browser-routing policy.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__cua_repl__js|mcp__cua_repl_js|mcp__codex_app__open_in_codex",
        "hooks": [
          {
            "type": "command",
            "command": "\"/usr/bin/python3\" \"/Users/hoya/.codex/hooks/browser-routing-policy.py\"",
            "timeout": 10,
            "statusMessage": "브라우저 라우팅 정책 확인"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/usr/bin/python3\" \"/Users/hoya/.codex/hooks/browser-routing-policy.py\"",
            "timeout": 10,
            "statusMessage": "브라우저 라우팅 정책 확인"
          },
          {
            "type": "command",
            "command": "\"/bin/sh\" \"/Users/hoya/.codex/skills/secretive/scripts/ensure-notify-key.sh\"",
            "timeout": 10,
            "statusMessage": "Secretive SSH 키 확인"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/bin/bash\" \"/Users/hoya/.dotfiles/scripts/codex-sync.sh\"",
            "timeout": 120,
            "statusMessage": "Dotfiles 동기화"
          }
        ]
      }
    ],
    "Stop": []
  }
}
